# ============================================================
# Environment Variables untuk PRODUCTION (Vercel)
# ============================================================
# Salin nilai-nilai ini ke Vercel Dashboard:
#   Project → Settings → Environment Variables
# JANGAN isi file ini dengan nilai asli dan commit ke GitHub!
# ============================================================

# --- DATABASE ---
# MongoDB Atlas connection string (https://cloud.mongodb.com)
# Daftar gratis, buat cluster M0, klik Connect → Drivers, salin URI-nya
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pos-system?retryWrites=true&w=majority

# --- AUTH ---
# NextAuth.js secret — WAJIB di production, minimal 32 karakter acak
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter

# URL aplikasi di Vercel — isi setelah deploy pertama
# Format: https://nama-project.vercel.app  (tanpa trailing slash)
NEXTAUTH_URL=https://nama-project.vercel.app

# --- NOTIFIKASI WHATSAPP ---
# Token dari Fonnte (https://fonnte.com)
# Daftar, hubungkan nomor WA pengirim, salin token dari dashboard
# Kosongkan jika belum pakai — notifikasi akan di-log ke console
FONNTE_TOKEN=

# --- PEMBAYARAN BANK TRANSFER ---
# Format: NamaBank|NomorRekening|NamaPemilik
# Kosongkan bank yang tidak dipakai
STORE_BANK_TRANSFER_BCA=BCA|NomorRekeningBCA|NamaPemilik
STORE_BANK_TRANSFER_MANDIRI=Mandiri|NomorRekeningMandiri|NamaPemilik
STORE_BANK_TRANSFER_BNI=BNI|NomorRekeningBNI|NamaPemilik
STORE_BANK_TRANSFER_BRI=BRI|NomorRekeningBRI|NamaPemilik

# --- PEMBAYARAN E-WALLET ---
# Nomor e-wallet toko (diekspos ke client, boleh kosong jika tidak pakai)
NEXT_PUBLIC_EWALLET_DANA_NUMBER=
NEXT_PUBLIC_EWALLET_OVO_NUMBER=
NEXT_PUBLIC_EWALLET_GOPAY_NUMBER=

# --- KEAMANAN ---
# Secret untuk endpoint cron (expire QRIS) — WAJIB di production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=ganti-dengan-secret-cron-hex-64-karakter

# Secret untuk verifikasi webhook payment gateway — WAJIB jika pakai webhook
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=ganti-dengan-secret-webhook-hex-64-karakter
