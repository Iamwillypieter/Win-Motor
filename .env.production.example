# ============================================================
# Environment Variables untuk PRODUCTION (Vercel)
# ============================================================
# Salin nilai-nilai ini ke Vercel Dashboard:
# Project → Settings → Environment Variables
# ============================================================

# MongoDB Atlas connection string
# Daftar di https://cloud.mongodb.com (gratis untuk M0 cluster)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pos-system?retryWrites=true&w=majority

# NextAuth.js secret — WAJIB di production
# Generate dengan: openssl rand -base64 32
# Atau: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter

# URL aplikasi di Vercel (isi setelah deploy pertama)
# Format: https://nama-project.vercel.app
NEXTAUTH_URL=https://nama-project.vercel.app

# WhatsApp notification via Fonnte (https://fonnte.com)
# Kosongkan jika belum punya — notifikasi akan di-log ke console
FONNTE_TOKEN=

# Payment webhook secret
# Generate dengan: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=ganti-dengan-secret-webhook

# Vercel Cron secret — otomatis diset oleh Vercel, tapi bisa di-override
# Generate dengan: openssl rand -hex 32
CRON_SECRET=ganti-dengan-secret-cron
