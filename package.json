{
  "name": "pos-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-https-cert.mjs",
    "dev": "next dev --turbo --hostname 0.0.0.0",
    "dev:proxy": "node scripts/https-proxy.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run tests/unit",
    "test:property": "vitest --run tests/property",
    "test:integration": "vitest --run tests/integration",
    "seed": "node scripts/seed.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop pos-system",
    "pm2:restart": "pm2 restart pos-system",
    "pm2:logs": "pm2 logs pos-system",
    "pm2:status": "pm2 list"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.14.0",
    "mongoose": "^9.6.1",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.31",
    "qrcode.react": "4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "fast-check": "^4.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "selfsigned": "^2.4.1",
    "tailwindcss": "^3.4.1",
    "vitest": "^4.1.5"
  }
