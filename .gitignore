# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Sertifikat HTTPS dev (self-signed) — jangan commit
/.cert/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — JANGAN commit file .env apapun selain *.example
.env*.local
.env
.env.production
.env.staging
.env.test
 
# uploaded product images — simpan di cloud storage (Cloudinary/S3) di production
# file lokal di public/uploads/ tidak boleh masuk repo
/public/uploads/

# backup files — jangan commit ke repo, simpan di cloud/USB terpisah
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE dan OS artifacts
.idea/
*.swp
*.swo
Thumbs.db
