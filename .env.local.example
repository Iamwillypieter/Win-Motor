# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/pos-system

# NextAuth.js secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# NextAuth.js URL (required in production)
NEXTAUTH_URL=http://localhost:3000

# WhatsApp notification via Fonnte (https://fonnte.com)
# Jika tidak diset, notifikasi hanya di-log ke console (mode simulasi)
FONNTE_TOKEN=your-fonnte-token-here

# Payment webhook secret (untuk verifikasi signature dari payment gateway)
PAYMENT_WEBHOOK_SECRET=your-webhook-secret-here
