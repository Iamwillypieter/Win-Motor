# ============================================================
# Environment Variables untuk LOCAL DEVELOPMENT
# ============================================================
# Salin file ini ke .env.local dan isi nilainya:
#   copy .env.local.example .env.local
# ============================================================

# MongoDB — gunakan MongoDB lokal atau MongoDB Atlas
# Lokal:  mongodb://localhost:27017/pos-system
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/pos-system
MONGODB_URI=mongodb://localhost:27017/pos-system

# NextAuth.js secret — bisa pakai nilai apapun di local
NEXTAUTH_SECRET=local-dev-secret-tidak-perlu-kuat

# URL lokal — jangan diubah untuk development
NEXTAUTH_URL=http://localhost:3000

# WhatsApp notification via Fonnte (https://fonnte.com)
# Kosongkan untuk mode simulasi (pesan di-log ke console)
FONNTE_TOKEN=

# Payment webhook secret — bisa pakai nilai apapun di local
PAYMENT_WEBHOOK_SECRET=local-webhook-secret

# Cron secret — digunakan untuk mengamankan endpoint cron (expire-qris, backup-db)
# Gunakan string acak yang panjang dan sulit ditebak
# CRON_SECRET=

# NEXT_PUBLIC_CRON_SECRET — hanya diperlukan jika halaman /owner/backup
# digunakan di production. Di development tidak perlu karena CRON_SECRET tidak di-set.
# NEXT_PUBLIC_CRON_SECRET=
